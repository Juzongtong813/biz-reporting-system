.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  border-radius: 20rpx;
  padding: 36rpx;
  color: #fff;
  margin-bottom: 28rpx;
}

.user-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
}

.user-city {
  font-size: 26rpx;
  opacity: 0.85;
}

.year-label {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-top: 12rpx;
}

/* 未登录：内容卡片通用 */
.intro-card,
.flow-card,
.demo-card,
.rules-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 系统简介 */
.intro-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 14rpx;
}

.intro-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

/* 填报流程 — 横排改竖排，间距更紧凑 */
.flow-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 20rpx;
}

.flow-steps {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.flow-step {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  text-align: center;
  line-height: 44rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.4;
}

.flow-arrow {
  display: none;
}

/* 月度示意 */
.demo-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 20rpx;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.month-cell {
  background: #f7f8fa;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.month-cell.submitted {
  background: #f0f9ff;
  border-color: #91caff;
}

.month-num {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
}

.month-status {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.month-cell.submitted .month-status {
  color: #1677ff;
}

.demo-hint {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  display: block;
  margin-top: 16rpx;
}

/* 填报规则 */
.rules-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 14rpx;
}

.rule-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.9;
  padding: 2rpx 0;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  border-radius: 12rpx;
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 年度包卡片（已登录） */
.package-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.pkg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.pkg-title {
  font-size: 30rpx;
  font-weight: bold;
}

.pkg-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.pkg-status.draft {
  background: #fff7e6;
  color: #fa8c16;
}

.pkg-status.submitted {
  background: #f6ffed;
  color: #52c41a;
}

/* 代维入口 */
.maintenance-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.maintenance-icon {
  font-size: 40rpx;
}

.maintenance-text {
  flex: 1;
  font-size: 30rpx;
}

.maintenance-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.version-tag { text-align: center; font-size: 20rpx; color: #ccc; padding: 20rpx 0; display: block; }
