<view class="page">
  <view class="header-bar">
    <view class="header-top">
      <text class="header-title">消息中心</text>
      <view class="header-badge" wx:if="{{unreadCount > 0}}">
        <text class="header-badge-num">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      </view>
    </view>
    <view class="header-accent"></view>
    <text class="header-tip" wx:if="{{isLoggedIn}}">已登录后会自动刷新未读数</text>
  </view>

  <view class="state-card" wx:if="{{loading}}">
    <text class="state-text">消息加载中...</text>
  </view>

  <view class="state-card" wx:elif="{{status === 'guest'}}">
    <text class="state-title">未登录</text>
    <text class="state-text">登录后才能查看城市用户消息和未读提醒。</text>
  </view>

  <view class="state-card error" wx:elif="{{status === 'error'}}">
    <text class="state-title">加载失败</text>
    <text class="state-text">{{errorMessage}}</text>
    <button class="retry-btn" bindtap="onRetryTap">重试</button>
  </view>

  <view class="state-card" wx:elif="{{status === 'empty'}}">
    <text class="state-title">暂无消息</text>
    <text class="state-text">有填报提醒时会在这里显示。</text>
  </view>

  <view class="panel" wx:else>
    <view class="msg-list">
      <view
        class="msg-item {{msg.isRead ? '' : 'unread'}}"
        wx:for="{{messages}}"
        wx:key="id"
        wx:for-item="msg"
        data-id="{{msg.id}}"
        bindtap="onMsgTap"
      >
        <view class="msg-left">
          <view class="msg-dot" wx:if="{{!msg.isRead}}"></view>
        </view>
        <view class="msg-body">
          <view class="msg-head">
            <text class="msg-title">{{msg.title}}</text>
            <text class="msg-tag" wx:if="{{!msg.isRead}}">未读</text>
          </view>
          <text class="msg-summary">{{msg.summary}}</text>
          <text class="msg-time">{{msg.createdAt}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
