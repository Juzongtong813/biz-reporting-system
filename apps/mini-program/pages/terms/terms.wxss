/* 服务协议阅读页 — 延续冷蓝/浅灰/细边框风格 */
page {
  background: #edf0f5;
}

.terms-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.terms-card {
  width: 100%;
  background: #ffffff;
  border: 1rpx solid #e4e7ed;
  border-radius: 14rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.terms-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 28rpx;
}

.terms-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.terms-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-top: 16rpx;
}

.terms-section-title:first-child {
  margin-top: 0;
}

.terms-text {
  display: block;
  font-size: 24rpx;
  color: #5b6778;
  line-height: 1.7;
  text-align: justify;
}

.back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 32rpx;
  border: 1rpx solid #1a5cff;
  background: #ffffff;
  color: #1a5cff;
  text-align: center;
  padding: 0;
}

.back-btn:active {
  background: #f4f5f8;
}
