<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading-box">
    <text>加载中...</text>
  </view>

  <!-- 只读视图（已提交） -->
  <view wx:elif="{{isReadOnly}}" class="readonly-view">
    <view class="section-title">{{monthNo}}月填报数据（只读）</view>

    <view wx:if="{{lockReason}}" class="locked-badge">{{lockReason}}</view>

    <view class="section">
      <view class="subsection-title">合同行</view>
      <view class="row-item" wx:for="{{contractRows}}" wx:key="contractId">
        <text class="row-name">{{item.contractNameSnapshot || '合同 #'+item.contractId}}</text>
        <view class="row-fields">
          <text>完工: {{item.completionAmount}}</text>
          <text>审定: {{item.acceptanceAmount}}</text>
        </view>
      </view>
      <view wx:if="{{contractRows.length === 0}}" class="empty-hint">暂无合同数据</view>
    </view>

    <view class="section">
      <view class="subsection-title">费用</view>
      <view class="row-item" wx:for="{{costRows}}" wx:key="costCategoryCode">
        <text class="row-name">{{item.costCategoryLabel}}</text>
        <text class="row-value">{{item.amount}}</text>
      </view>
    </view>

    <view class="section" wx:if="{{maintenanceRow && enableMaintenance}}">
      <view class="subsection-title">维保</view>
      <view class="row-item">
        <text class="row-name">上年度发票总额</text>
        <text class="row-value">{{maintenanceRow.invoiceTotalPrevYear}}</text>
      </view>
      <view class="row-item">
        <text class="row-name">上年度发票月数</text>
        <text class="row-value">{{maintenanceRow.invoiceMonthCountPrevYear}}</text>
      </view>
      <view class="row-item">
        <text class="row-name">本年度发票总额</text>
        <text class="row-value">{{maintenanceRow.invoiceTotalCurrentYear}}</text>
      </view>
    </view>

    <button class="back-btn" bindtap="goBack">返回首页</button>
  </view>

  <!-- 编辑视图 -->
  <view wx:else class="edit-view">
    <view class="section-title">{{monthNo}}月填报</view>

    <!-- 合同行 -->
    <view class="section">
      <view class="subsection-title">合同行</view>
      <view class="contract-row" wx:for="{{contractRows}}" wx:key="contractId" wx:for-index="idx">
        <text class="contract-name">{{item.contractNameSnapshot || '合同 #'+item.contractId}}</text>
        <view class="field-group">
          <view class="field">
            <text class="field-label">完工金额</text>
            <input class="field-input" type="digit" value="{{item.completionAmount}}" data-index="{{idx}}" bindinput="onContractCompletionInput" />
          </view>
          <view class="field">
            <text class="field-label">审定金额</text>
            <input class="field-input" type="digit" value="{{item.acceptanceAmount}}" data-index="{{idx}}" bindinput="onContractAcceptanceInput" />
          </view>
        </view>
      </view>
      <view wx:if="{{contractRows.length === 0}}" class="empty-hint">暂无合同数据</view>
    </view>

    <!-- 费用行 -->
    <view class="section">
      <view class="subsection-title">费用</view>
      <view class="cost-row" wx:for="{{costRows}}" wx:key="costCategoryCode" wx:for-index="idx">
        <text class="cost-label">{{item.costCategoryLabel}}</text>
        <input class="cost-input" type="digit" value="{{item.amount}}" data-index="{{idx}}" bindinput="onCostAmountInput" placeholder="0" />
      </view>
    </view>

    <!-- 维保行 -->
    <view class="section" wx:if="{{enableMaintenance}}">
      <view class="subsection-title">维保信息</view>
      <view class="field">
        <text class="field-label">上年度发票总额</text>
        <input class="field-input" type="digit" value="{{maintenanceRow.invoiceTotalPrevYear}}" data-field="invoiceTotalPrevYear" bindinput="onMaintenanceInput" placeholder="0" />
      </view>
      <view class="field">
        <text class="field-label">上年度发票月数</text>
        <input class="field-input" type="digit" value="{{maintenanceRow.invoiceMonthCountPrevYear}}" data-field="invoiceMonthCountPrevYear" bindinput="onMaintenanceInput" placeholder="0" />
      </view>
      <view class="field">
        <text class="field-label">本年度发票总额</text>
        <input class="field-input" type="digit" value="{{maintenanceRow.invoiceTotalCurrentYear}}" data-field="invoiceTotalCurrentYear" bindinput="onMaintenanceInput" placeholder="0" />
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <button class="btn-secondary" loading="{{saving}}" bindtap="handleDraftSave">
        {{saving ? '保存中...' : '保存草稿'}}
      </button>
      <button class="btn-primary" loading="{{saving}}" bindtap="handlePreview">
        {{saving ? '计算中...' : '提交预览'}}
      </button>
    </view>
  </view>

  <!-- 预览弹窗 -->
  <view wx:if="{{showPreview && previewData}}" class="modal-overlay" bindtap="handleClosePreview">
    <view class="modal-content" catchtap="noop">
      <text class="modal-title">提交预览</text>
      <view class="preview-row">
        <text>完工合计</text><text>{{previewData.completionTotal}} 元</text>
      </view>
      <view class="preview-row">
        <text>审定合计</text><text>{{previewData.acceptanceTotal}} 元</text>
      </view>
      <view class="preview-row">
        <text>费用合计</text><text>{{previewData.costTotal}} 元</text>
      </view>
      <view class="preview-row highlight">
        <text>毛利</text><text>{{previewData.grossProfit}} 元</text>
      </view>
      <view class="preview-row {{previewData.isOverdue ? 'overdue' : ''}}">
        <text>逾期状态</text><text>{{previewData.isOverdue ? '⏰ 逾期' : '✓ 正常'}}</text>
      </view>
      <view class="modal-actions">
        <button class="btn-secondary" bindtap="handleClosePreview">返回编辑</button>
        <button class="btn-primary" loading="{{submitting}}" bindtap="handleConfirmSubmit">
          {{submitting ? '提交中...' : '确认提交'}}
        </button>
      </view>
    </view>
  </view>
</view>
