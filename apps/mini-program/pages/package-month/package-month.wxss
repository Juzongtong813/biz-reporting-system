/* ========================================
   月度填报页 — 移动数据录入工具风格
   色系: 冷静蓝 #1a5cff / 青绿点缀 #14b8a6
   底色: #f0f2f5 | 面板: #ffffff
   边框: 1rpx solid #e4e7ed
   ======================================== */

.page {
  padding: 0 0 48rpx 0;
  min-height: 100vh;
  background: #f0f2f5;
}

/* ---------- 加载 ---------- */
.loading-box {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #9aa3b5;
  font-size: 26rpx;
}

/* ---------- 页面标题 ---------- */
.page-title {
  text-align: center;
  padding: 28rpx 24rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  background: #ffffff;
  border-bottom: 1rpx solid #e4e7ed;
  margin-bottom: 14rpx;
}

/* ---------- 锁定提示 ---------- */
.locked-badge {
  text-align: center;
  color: #ef4444;
  font-size: 22rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin: 0 20rpx 14rpx;
}

/* ---------- 内容面板 ---------- */
.section {
  background: #ffffff;
  border: 1rpx solid #e4e7ed;
  border-radius: 12rpx;
  margin: 0 20rpx 14rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #e4e7ed;
}

/* ---------- 合同行 ---------- */
.contract-row, .row-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.contract-row:last-child, .row-item:last-child {
  border-bottom: none;
}

.contract-name, .row-name {
  font-size: 24rpx;
  color: #1a1a2e;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.field-group, .row-fields {
  display: flex;
  gap: 12rpx;
}

.field {
  flex: 1;
}

.field-label {
  font-size: 20rpx;
  color: #9aa3b5;
  display: block;
  margin-bottom: 6rpx;
}

.field-input {
  width: 100%;
  height: 70rpx;
  background: #f4f5f8;
  border: 1rpx solid #e4e7ed;
  border-radius: 8rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #1a1a2e;
  text-align: right;
}

.field-input:focus {
  border-color: #1a5cff;
}

/* ---------- 费用行 ---------- */
.cost-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
}

.cost-row:last-child {
  border-bottom: none;
}

.cost-label {
  width: 150rpx;
  font-size: 24rpx;
  color: #1a1a2e;
  flex-shrink: 0;
  font-weight: 500;
}

.cost-input {
  flex: 1;
  height: 70rpx;
  background: #f4f5f8;
  border: 1rpx solid #e4e7ed;
  border-radius: 8rpx;
  padding: 0 14rpx;
  font-size: 26rpx;
  text-align: right;
  box-sizing: border-box;
  color: #1a1a2e;
}

.cost-input:focus {
  border-color: #1a5cff;
}

/* ---------- 只读态 ---------- */
.row-value {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 500;
}

/* ---------- 空 ---------- */
.empty-hint {
  text-align: center;
  color: #c0c4cc;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* ---------- 操作栏 ---------- */
.action-bar {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 20rpx 0;
  padding-bottom: 48rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  text-align: center;
  font-weight: 500;
}

.btn-primary {
  background: #1a5cff;
  color: #ffffff;
  border: none;
}

.btn-primary:active {
  background: #154ed6;
}

.btn-secondary {
  background: #ffffff;
  border: 1rpx solid #d0d4dd;
  color: #5b6778;
}

.btn-secondary:active {
  background: #f4f5f8;
}

/* ---------- 返回按钮（只读） ---------- */
.back-btn {
  width: calc(100% - 40rpx);
  margin: 20rpx 20rpx 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  background: #1a5cff;
  color: #ffffff;
  font-weight: 500;
  border: none;
}

/* ========================================
   预览弹窗 — 数据确认面板风格
   ======================================== */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 26, 46, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 36rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
  color: #1a1a2e;
}

/* 数据行 */
.preview-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f1f4;
  color: #5b6778;
}

/* 毛利高亮 */
.preview-row.profit {
  background: #f0f9ff;
  margin: 6rpx -12rpx;
  padding: 18rpx 12rpx;
  border-radius: 8rpx;
  border-bottom: 1rpx solid #dbeafe;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a5cff;
}

/* 逾期 */
.preview-row.overdue {
  color: #ef4444;
  font-weight: 500;
}

/* 确认按钮区 */
.modal-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 32rpx;
}

.noop {
  /* no-op */
}
