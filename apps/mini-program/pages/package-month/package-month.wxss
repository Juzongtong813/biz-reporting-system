.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8f9fb;
}

.loading-box {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 通用 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-align: center;
  color: #1a1a1a;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.subsection-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 合同行 */
.contract-row, .row-item {
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.contract-row:last-child, .row-item:last-child {
  border-bottom: none;
}

.contract-name, .row-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.field-group, .row-fields {
  display: flex;
  gap: 16rpx;
}

.field {
  flex: 1;
}

.field-label {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-bottom: 6rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #1677ff;
}

/* 费用行 */
.cost-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.cost-row:last-child {
  border-bottom: none;
}

.cost-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #333;
  flex-shrink: 0;
  font-weight: 500;
}

.cost-input {
  flex: 1;
  height: 72rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  text-align: right;
  box-sizing: border-box;
}

.cost-input:focus {
  border-color: #1677ff;
}

/* 只读 */
.row-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.empty-hint {
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
  padding: 20rpx 0;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}

.btn-primary {
  background: #1677ff;
  color: #fff;
  border: none;
}

.btn-secondary {
  background: #fff;
  border: 2rpx solid #d9d9d9;
  color: #555;
}

.back-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  text-align: center;
  background: #1677ff;
  color: #fff;
  margin-top: 32rpx;
  font-weight: 500;
}

/* 预览弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  display: block;
  margin-bottom: 28rpx;
  color: #1a1a1a;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
  border-bottom: 2rpx solid #f5f5f5;
  color: #555;
}

.preview-row.highlight {
  color: #1677ff;
  font-weight: bold;
  font-size: 32rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #e6f4ff;
  background: #f0f9ff;
  margin: 4rpx -12rpx;
  padding: 18rpx 12rpx;
  border-radius: 8rpx;
}

.preview-row.overdue {
  color: #ff4d4f;
  font-weight: 500;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

/* 用于阻止弹窗点击穿透 */
.noop {
  /* no-op */
}

/* 只读视图锁定提示 */
.locked-badge {
  text-align: center;
  color: #ff4d4f;
  font-size: 24rpx;
  background: #fff2f0;
  border-radius: 8rpx;
  padding: 12rpx;
  margin-bottom: 16rpx;
}
