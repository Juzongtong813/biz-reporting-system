<view class="login-container">
  <view class="login-bg-layer"></view>
  
  <view class="login-header">
    <text class="logo-label">经营单元上报系统</text>
    <text class="logo-title">数据填报平台</text>
    <text class="logo-desc">地市级经营单元月度数据上报与成本管理</text>
  </view>

  <!-- 登录 -->
  <view hidden="{{showBind}}" class="login-panel">
    <view class="panel-inner">
      <view class="privacy-row" bindtap="onAgreePrivacyChange">
        <view class="custom-checkbox {{agreePrivacy ? 'checked' : ''}}">
          <text class="check-mark" wx:if="{{agreePrivacy}}">✓</text>
        </view>
        <view class="privacy-content">
          <text class="privacy-text">已阅读并同意</text>
          <text class="privacy-link" catchtap="onOpenTerms">《服务协议》</text>
          <text class="privacy-text">和</text>
          <text class="privacy-link" catchtap="onOpenPrivacy">《隐私政策》</text>
        </view>
      </view>

      <button class="login-btn" type="primary" loading="{{loading}}" disabled="{{!agreePrivacy}}" bindtap="handleLogin">
        {{loading ? '登录中...' : '微信一键登录'}}
      </button>

      <text class="login-helper">仅限已由管理员预建并完成微信绑定的账号</text>
    </view>
  </view>

  <!-- 邀请绑定 -->
  <view hidden="{{!showBind}}" class="login-panel">
    <view class="panel-inner">
      <view class="form-item">
        <text class="form-label">微信绑定邀请</text>
        <input class="form-input" password placeholder="请输入管理员签发的一次性邀请" value="{{invitationToken}}" bindinput="onInvitationInput" />
      </view>

      <button class="login-btn" type="primary" loading="{{bindLoading}}" bindtap="handleBind">
        {{bindLoading ? '绑定中...' : '绑定并登录'}}
      </button>
      <text class="back-link" bindtap="backToLogin">← 返回登录</text>
    </view>
  </view>

  <text wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</text>
</view>
