.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 0;
  min-height: 100vh;
  background: #f8f9fb;
}

.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1677ff;
  display: block;
  letter-spacing: 2rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.login-section, .register-form {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 32rpx;
  border: none;
}

/* 按钮禁用态 — 审核员需要一眼看清 */
.login-btn[disabled] {
  opacity: 0.45;
  background: #1677ff !important;
  color: #fff !important;
}

/* 注册表单 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #555;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: #f7f8fa;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 84rpx;
}

.form-input:focus {
  border-color: #1677ff;
}

.picker-value {
  color: #333;
  line-height: 84rpx;
}

.back-link {
  color: #1677ff;
  font-size: 26rpx;
  text-align: center;
  display: block;
  margin-top: 24rpx;
}

.error-msg {
  color: #ff4d4f;
  font-size: 26rpx;
  margin-top: 20rpx;
  background: #fff2f0;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  width: 100%;
  text-align: center;
  box-sizing: border-box;
}

/* 隐私协议勾选 */
.privacy-row {
  display: flex;
  align-items: center;
  margin: 16rpx 0 0;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fafbfc;
  transition: background 0.2s;
}

/* 自定义勾选框 */
.custom-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #d0d0d0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 14rpx;
  box-sizing: border-box;
  background: #fff;
  transition: all 0.2s;
}

.custom-checkbox.checked {
  background: #1677ff;
  border-color: #1677ff;
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
}

.privacy-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.privacy-link {
  color: #1677ff;
  font-weight: 500;
}

.version-tag { text-align: center; font-size: 20rpx; color: #ccc; padding: 20rpx 0; display: block; }
