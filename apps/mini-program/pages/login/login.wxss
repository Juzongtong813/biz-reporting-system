/* ========================================
   登录页 — 企业登录入口
   色系: #1a5cff / #14b8a6
   底色: #f0f2f5
   ======================================== */

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 44rpx;
  background: #edf0f5;
  position: relative;
  overflow: hidden;
}

/* ---------- 极淡冷色层次 ---------- */
.login-bg-layer {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: rgba(26, 92, 255, 0.025);
  pointer-events: none;
}

/* ---------- 标题区域 ---------- */
.login-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.logo-label {
  font-size: 22rpx;
  color: #9aa3b5;
  display: block;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.logo-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.logo-desc {
  font-size: 24rpx;
  color: #9aa3b5;
  display: block;
  line-height: 1.5;
}

/* ---------- 登录面板 ---------- */
.login-panel {
  width: 100%;
}

.panel-inner {
  background: #ffffff;
  border: 1rpx solid #e4e7ed;
  border-radius: 14rpx;
  padding: 32rpx 28rpx;
}

/* ---------- 按钮 ---------- */
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 24rpx;
  border: none;
  background: #1a5cff;
  color: #ffffff;
  text-align: center;
  padding: 0;
}

.login-btn[disabled] {
  opacity: 0.35;
  background: #1a5cff !important;
  color: #ffffff !important;
}

.login-btn:not([disabled]):active {
  background: #154ed6;
}

/* ---------- 按钮下方辅助说明 ---------- */
.login-helper {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 16rpx;
}

/* ---------- 注册表单 ---------- */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #5b6778;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f4f5f8;
  border: 1rpx solid #e4e7ed;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  line-height: 80rpx;
  color: #1a1a2e;
}

.form-input:focus {
  border-color: #1a5cff;
}

.picker-value {
  color: #1a1a2e;
  line-height: 80rpx;
}

.back-link {
  color: #1a5cff;
  font-size: 24rpx;
  text-align: center;
  display: block;
  margin-top: 20rpx;
}

.back-link:active {
  opacity: 0.6;
}

/* ---------- 错误消息 ---------- */
.error-msg {
  color: #ef4444;
  font-size: 24rpx;
  margin-top: 16rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  width: calc(100% - 88rpx);
  text-align: center;
  box-sizing: border-box;
}

/* ---------- 隐私协议模块 ---------- */
.privacy-row {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  background: #f4f5f8;
  border-radius: 10rpx;
  border: 1rpx solid #e4e7ed;
}

.custom-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c8ccd6;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 14rpx;
  box-sizing: border-box;
  background: #ffffff;
  transition: all 0.15s;
}

.custom-checkbox.checked {
  background: #1a5cff;
  border-color: #1a5cff;
}

.check-mark {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
}

.privacy-content {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 2rpx;
}

.privacy-text {
  font-size: 22rpx;
  color: #5b6778;
  line-height: 1.5;
}

.privacy-link {
  color: #1a5cff;
  font-weight: 500;
  font-size: 22rpx;
}
