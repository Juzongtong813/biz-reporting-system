# ============================================================
# 经营单元上报系统 - API 环境配置
# 复制此文件为 .env.local 并修改实际值
# ============================================================

# 服务端口
PORT=3000
NODE_ENV=development
DEPLOY_ENV=local

# ---- MySQL 数据库 ----
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=biz_reporting
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_QUEUE_LIMIT=0
DB_SYNC=false          # 生产环境务必 false，用 migration
DB_LOGGING=true         # 开发环境开启 SQL 日志

# ---- 源文件存储（D6：私有 COS 对象存储 + 后端 COS SDK 直连）----
# 存储驱动：'cos'（私有 COS SDK 直连，生产默认，见 Dockerfile）或 'local'（本地盘回滚路径，
# 历史 CFS 挂载方案，**非当前方案**；仅本地开发/回滚用，生产使用 local 需另配存储根变量）。
FACT_SOURCE_STORAGE_DRIVER=cos

# 私有 COS 桶（COS SDK 直连方案必填；凭据经 STS 临时凭据注入，禁止长期密钥写入仓库/日志）
COS_BUCKET=
COS_REGION=
COS_OBJECT_PREFIX=fact-source-files/
# STS 临时凭据：生产由凭据提供器注入（BLOCKED_STS_ISSUER_UNDEFINED —— 真实 STS issuer 待 F 阶段确认）；
# 以下变量仅供本地 fake 联调，**不得**填入真实长期密钥。
COS_SECRET_ID=
COS_SECRET_KEY=
# 可选：COS_SESSION_TOKEN / COS_CREDENTIAL_EXPIRES_AT（STS 临时凭据形态）
# COS_SESSION_TOKEN=
# COS_CREDENTIAL_EXPIRES_AT=

# ---- JWT 认证 ----
# 必填。使用密钥管理服务注入随机值；缺失或仅含空白时 API 拒绝启动。
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 签发与验证共用的 issuer/audience（生产必填，禁止为空）
JWT_ISSUER=biz-reporting-api
JWT_AUDIENCE=biz-reporting-clients

# ---- 登录安全 ----
# 独立密钥，用于登录哈希桶与审计事件 HMAC；必填且禁止等于 JWT_SECRET
AUTH_SECURITY_HMAC_KEY=
# IP 级限流与账号锁定窗口（生产必填）
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_IP_MAX=5
AUTH_ACCOUNT_WINDOW_MS=900000
AUTH_ACCOUNT_MAX_FAILURES=5
AUTH_ACCOUNT_BLOCK_MS=900000

# ---- 可信代理（生产必填，只接受 1-3 的整数）----
TRUST_PROXY_HOPS=1

# ---- readiness 探针 ----
# 结果缓存与依赖探测超时（生产必填）
READINESS_CACHE_MS=5000
READINESS_TIMEOUT_MS=2000

# ---- 微信小程序（TODO）----
WECHAT_APPID=
WECHAT_SECRET=

# ---- CORS ----
# production 必填；仅允许逗号分隔的完整 HTTPS origin，禁止 *、localhost 和路径
CORS_ORIGINS=https://your-admin-web-domain.com,https://your-miniprogram-domain.com


