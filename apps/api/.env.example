# ============================================================
# 经营单元上报系统 - API 环境配置
# 复制此文件为 .env.local 并修改实际值
# ============================================================

# 服务端口
PORT=3000
NODE_ENV=development

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=biz_reporting
DB_SYNC=false          # 生产环境务必 false，用 migration
DB_LOGGING=true         # 开发环境开启 SQL 日志

# ---- JWT 认证 ----
JWT_SECRET=biz-reporting-jwt-secret-change-in-production
JWT_EXPIRES_IN=8h

# ---- 微信小程序（TODO）----
WECHAT_APPID=
WECHAT_SECRET=

# ---- CORS ----
CORS_ORIGINS=https://your-admin-web-domain.com,https://your-miniprogram-domain.com

# ---- 文件上传（TODO）----
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
