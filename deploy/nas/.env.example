# NAS host paths. Use the exact Linux path on fnOS.
NAS_DATA_ROOT=/mnt/pool/docker/biz-reporting

# Public root domain, without scheme or path.
DOMAIN=example.com

# New, NAS-only database. Do not reuse CloudBase credentials.
DB_DATABASE=biz_reporting_nas
DB_USERNAME=biz_nas_runtime
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DB_POOL_CONNECTION_LIMIT=8
DB_POOL_QUEUE_LIMIT=100
DB_LOGGING=false

# Generate independent values. Never commit the real values.
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_SECURITY_HMAC_KEY=replace-with-a-different-at-least-32-random-characters
JWT_EXPIRES_IN=8h
JWT_ISSUER=biz-reporting-api
JWT_AUDIENCE=biz-reporting-clients

# Reverse proxy settings. Keep high ports initially to avoid fnOS conflicts.
NPM_HTTP_PORT=18080
NPM_HTTPS_PORT=18443
NPM_ADMIN_PORT=18181
TRUST_PROXY_HOPS=1

# Fill this only after creating a named Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-after-cloudflare-tunnel-creation

# Optional because this NAS deployment does not use WeChat login initially.
WECHAT_APPID=
WECHAT_SECRET=
